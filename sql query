SELECT
  o.Date AS order_date,
  k.CategoryName AS category_name,
  p.ProdName AS product_name,
  p.Price AS product_price,
  o.Quantity AS order_qty,
  o.Quantity * p.Price AS total_sales,
  SPLIT(c.CustomerEmail, '#')[OFFSET(0)] AS cust_email,
  c.CustomerCity AS cust_city
FROM `rakamin-bank-muamalat-511313.sales_data.orders` AS o
JOIN `rakamin-bank-muamalat-511313.sales_data.product` AS p
  ON o.ProdNumber = p.ProdNumber
JOIN `rakamin-bank-muamalat-511313.sales_data.product_category` AS k
  ON p.Category = k.CategoryID
JOIN `rakamin-bank-muamalat-511313.sales_data.customers` AS c
  ON o.CustomerID = c.CustomerID
ORDER BY o.Date ASC, o.OrderID ASC;
